# Copy to .env (git-ignored) and fill in. Sourced by build.sh.
# Values with spaces MUST be quoted.

# Apple Developer Team ID (developer.apple.com → Membership).
DEVELOPMENT_TEAM=XXXXXXXXXX

# Signing identity. Unset => ad-hoc ("-") local build (helper inactive).
# For a notarized direct-download build that runs the helper:
# CODE_SIGN_IDENTITY="Developer ID Application"
# For local helper testing with a dev cert (match DEVELOPMENT_TEAM to it):
# CODE_SIGN_IDENTITY="Apple Development: Your Name (TEAMID)"
